# Use a unique Compose project (-p submerge-gateway-test). Never reuse production volumes.
GATEWAY_SUBMERGE_IMAGE=submerge-gateway:local
# Optional first-install seed. Configure TUN in Settings after boot.
GATEWAY_PROFILE_PATH=./config/proxy.example.json
# Existing fetch service's published directory. No deploy key is passed to Submerge.
GATEWAY_LISTS_DIR=/home/gentslava/mihomo/lists
GATEWAY_ADMIN_PASSWORD=
GATEWAY_MIHOMO_SECRET=
GATEWAY_COOKIE_SECURE=false
GATEWAY_UI_BIND=127.0.0.1
GATEWAY_UI_PORT=13000
GATEWAY_PROXY_PORT=17890
GATEWAY_DNS_BIND=127.0.0.1
GATEWAY_DNS_PORT=11053
GATEWAY_LAN_SUBNET=172.30.220.0/24
GATEWAY_LAN_IP=172.30.220.2
# Optional real-LAN override (Linux; set explicit unused address and actual parent).
# GATEWAY_LAN_PARENT=eth0
# GATEWAY_LAN_ROUTER=192.168.1.1
